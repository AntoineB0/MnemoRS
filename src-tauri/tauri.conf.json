{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MnemoRS",
  "version": "0.1.0",
  "identifier": "com.icetech.mnemors",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MnemoRS",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "DeveloperTool",
    "shortDescription": "Terminal avec assistant IA",
    "longDescription": "Emulateur de terminal avec un assistant IA qui connait l'historique des commandes.",
    "linux": {
      "rpm": {
        "files": {
          "/usr/share/applications/com.icetech.mnemors.desktop": "linux/com.icetech.mnemors.desktop"
        }
      }
    }
  }
}
